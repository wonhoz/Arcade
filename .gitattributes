# ============================================================================
# 줄바꿈 정책
#
#   저장소(blob) = LF, 작업트리 = OS 기본(Windows 는 CRLF)
#
# 지금까지 이 동작은 각 PC 의 core.autocrlf 설정에만 의존하고 있었다.
# 설정이 다른 PC 에서 작업하면 한 줄만 고쳐도 파일 전체가 diff 로 뜨고,
# 장비 브랜치가 여러 개인 이 저장소에서는 그대로 머지 충돌이 된다.
# 아래로 저장소가 직접 정책을 갖는다.
#
# 주의 — 이 파일은 "현재 저장 상태를 그대로 못 박은 것"이다.
#   `git ls-files --eol` 로 실측한 결과 i/crlf · i/mixed 가 0개였고,
#   아래 규칙 적용 후 `git add --renormalize .` 결과도 0건이다.
#   즉 재정규화로 인한 대량 diff 없이 동작만 고정된다.
#
#   확장자 하나에 텍스트와 바이너리가 섞여 있는 것들(cfg·nut·dat·rdb·
#   vsh·slf·fp·key·pnach)은 일부러 지정하지 않았다. git 의 자동 판별에
#   맡겨야 지금 상태가 유지된다. 예) .nut 은 텍스트 109 / 바이너리 8,
#   .rdb 은 Project64 쪽 6개만 텍스트고 RetroArch 쪽 121개는 바이너리다.
# ============================================================================

*                       text=auto

# ----------------------------------------------------------------------------
# 체크아웃 OS 와 무관하게 CRLF 여야 하는 것
#   배치파일을 LF 로 내려받으면 cmd 가 일부 구문을 잘못 해석할 수 있다.
#   attract.bat 이 여기 해당한다.
# ----------------------------------------------------------------------------
*.bat                   text eol=crlf
*.cmd                   text eol=crlf

# ----------------------------------------------------------------------------
# 바이너리 — 줄바꿈 변환 금지 + diff/merge 시도 금지
#   전부 현재 100% 바이너리로 저장돼 있는 확장자만 골랐다(실측 확인).
# ----------------------------------------------------------------------------
*.exe                   binary
*.dll                   binary
*.sym                   binary

*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.gif                   binary
*.ico                   binary
*.psd                   binary

*.ttf                   binary
*.otf                   binary
*.ttc                   binary

*.wav                   binary
*.mp3                   binary
*.mp4                   binary

*.zip                   binary
*.7z                    binary
*.chd                   binary
*.pdf                   binary
